# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon, Supabase, Railway, etc.)
# Do NOT add a `?sslmode=require` param — the app handles TLS itself
# (see lib/db-ssl.ts) and that param can actually break the connection.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret used to sign login sessions (JWT). Generate one with:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-value"

# Node environment: development | production
NODE_ENV="development"

# Optional — customize the first Admin account created by `npm run db:seed`.
# If unset, defaults to admin@interiorhomeservicesbc.com / ChangeMe123!
# ADMIN_EMAIL="you@interiorhomeservicesbc.com"
# ADMIN_PASSWORD="pick-a-strong-password"
# ADMIN_NAME="Your Name"
